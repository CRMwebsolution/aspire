# Supabase project settings. The publishable key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional server-only webhook used for lead notifications.
N8N_WEBHOOK_URL=https://your-n8n-instance.example/webhook/your-webhook-id
